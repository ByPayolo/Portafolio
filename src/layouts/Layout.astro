---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Paolo Mata | Fullstack Developer & Software Engineer",
  description = "Paolo Mata Portfolio — Full-Stack Developer & Software Engineer. Decoupled architectures, robust APIs, and reactive interfaces.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Google Fonts: DM Mono, Manrope, Playfair Display -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600&family=Playfair+Display:ital,wght@1,500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <!-- ── Topbar / Header ─────────────────────────────────────────────────── -->
    <header class="topbar">
      <div class="topbar-inner">
        <!-- Logo: P. -->
        <a href="#" class="logo" aria-label="Home">
          P<span class="dot">.</span>
        </a>

        <!-- Nav links -->
        <nav>
          <ul class="nav-links">
            <li><a href="#projects">Projects</a></li>
            <li><a href="#about-me">About me</a></li>
            <li><a href="#contact">Contact</a></li>
          </ul>
        </nav>

        <!-- Badge: Available -->
        <div class="badge-available">
          <span class="dot-live"></span>
          Available for projects
        </div>
      </div>
    </header>

    <!-- ── Main content ────────────────────────────────────────────────────── -->
    <main>
      <slot />
    </main>
  </body>
</html>
