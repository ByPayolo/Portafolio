---
// src/components/ProjectCard.astro
// Tarjeta de proyecto — Dark Editorial Asymmetric
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;

const num = String(index + 1).padStart(2, '0');
---

<article class="project-card">
  <!-- Card Content -->
  <div class="card-content">
    <span class="card-number">Project {num}</span>
    <h3 class="card-title">{project.title}</h3>
    <p class="card-subtitle">{project.description}</p>

    <!-- Tags -->
    <div class="card-tags">
      {project.tags.map((tag) => (
        <span>{tag}</span>
      ))}
    </div>

    <!-- CTA Button — opens DemoModal -->
    {project.demoUrl ? (
      <button
        type="button"
        data-demo-url={project.demoUrl}
        data-demo-title={project.title}
        class="card-btn demo-open-btn"
        aria-label={`View demo of ${project.title}`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        View Demo
      </button>
    ) : (
      <span class="card-btn" style="opacity: 0.4; cursor: default;">
        Coming Soon
      </span>
    )}
  </div>

  <!-- Card Visual (icon/emoji area) -->
  <div class="card-visual">
    <span>{project.icon}</span>
  </div>
</article>

<script>
  function initProjectCardEvents() {
    document.querySelectorAll<HTMLButtonElement>('.demo-open-btn').forEach((btn) => {
      if (btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => {
        const url   = btn.dataset.demoUrl   ?? '';
        const title = btn.dataset.demoTitle ?? 'Demo';
        document.dispatchEvent(
          new CustomEvent('open-demo-modal', { detail: { url, title } })
        );
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectCardEvents);
  } else {
    initProjectCardEvents();
  }
  document.addEventListener('astro:page-load', initProjectCardEvents);
</script>
