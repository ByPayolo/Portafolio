---
// src/components/RosePetalsCanvas.astro
// Cinematic rose petals particle system — Clair Obscur Art Direction
// Positioned as a fixed canvas layer, pointer-events-none, z-0
---

<canvas
  id="rose-petals-canvas"
  class="fixed inset-0 pointer-events-none"
  style="z-index: 0;"
  aria-hidden="true"
></canvas>

<script>
  // ── RosePetalsCanvas — client-side particle engine ──────────────────────
  (function () {
    // Respect user accessibility preference
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reducedMotion) return;

    const canvas = document.getElementById('rose-petals-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // ── Petal color palette ──────────────────────────────────────────────
    const PETAL_COLORS = [
      { r: 122, g: 18,  b: 18  }, // Deep Crimson  #7A1212
      { r: 92,  g: 17,  b: 24  }, // Shadowed Rose #5c1118
      { r: 148, g: 22,  b: 22  }, // Mid Crimson
      { r: 212, g: 175, b: 55  }, // Antique Gold  #D4AF37  (accent flash)
      { r: 100, g: 14,  b: 14  }, // Very Dark Crimson
    ];

    // Gold petals appear rarely (1 in 6 chance)
    function pickColor(): { r: number; g: number; b: number } {
      const roll = Math.random();
      if (roll < 0.17) return PETAL_COLORS[3]; // gold
      const idx = Math.floor(Math.random() * (PETAL_COLORS.length - 1)); // 0-3 (skip gold)
      return PETAL_COLORS[idx];
    }

    // ── Petal class ───────────────────────────────────────────────────────
    interface PetalConfig {
      x: number;
      y: number;
      width: number;
      height: number;
      rotation: number;
      rotSpeed: number;
      speedY: number;
      speedX: number;
      swingAmp: number;
      swingFreq: number;
      swingOffset: number;
      opacity: number;
      color: { r: number; g: number; b: number };
      time: number;
    }

    function createPetal(canvasW: number, canvasH: number, startAbove = false): PetalConfig {
      const w = 6 + Math.random() * 10;   // 6–16 px
      const h = w * (0.45 + Math.random() * 0.35); // aspect ratio
      return {
        x:          Math.random() * canvasW,
        y:          startAbove ? -(20 + Math.random() * canvasH * 0.5) : Math.random() * canvasH,
        width:      w,
        height:     h,
        rotation:   Math.random() * Math.PI * 2,
        rotSpeed:   (Math.random() - 0.5) * 0.014, // gentle spin
        speedY:     0.22 + Math.random() * 0.40,   // slow, cinematic fall
        speedX:     (Math.random() - 0.5) * 0.18,  // subtle drift
        swingAmp:   14 + Math.random() * 24,        // lateral swing
        swingFreq:  0.003 + Math.random() * 0.005,  // swing speed
        swingOffset: Math.random() * Math.PI * 2,   // phase
        opacity:    0.22 + Math.random() * 0.33,    // 0.22–0.55 subtle
        color:      pickColor(),
        time:       Math.random() * 1000,
      };
    }

    // ── Canvas setup ──────────────────────────────────────────────────────
    const PETAL_COUNT = 20 + Math.floor(Math.random() * 11); // 20–30
    let petals: PetalConfig[] = [];
    let animFrameId: number;
    let isActive = true;

    function resize() {
      canvas.width  = window.innerWidth;
      canvas.height = window.innerHeight;
    }

    function init() {
      resize();
      petals = Array.from({ length: PETAL_COUNT }, () =>
        createPetal(canvas.width, canvas.height, false)
      );
    }

    // ── Draw a single petal (smooth elongated ellipse) ────────────────────
    function drawPetal(p: PetalConfig) {
      ctx!.save();
      ctx!.translate(p.x, p.y);
      ctx!.rotate(p.rotation);

      // Soft radial gradient to give the petal volume
      const grad = ctx!.createRadialGradient(0, 0, 0, 0, 0, p.width * 0.8);
      const { r, g, b } = p.color;
      grad.addColorStop(0,   `rgba(${r},${g},${b},${p.opacity})`);
      grad.addColorStop(0.55,`rgba(${r},${g},${b},${p.opacity * 0.7})`);
      grad.addColorStop(1,   `rgba(${r},${g},${b},0)`);

      ctx!.fillStyle = grad;
      ctx!.beginPath();
      ctx!.ellipse(0, 0, p.width, p.height, 0, 0, Math.PI * 2);
      ctx!.fill();
      ctx!.restore();
    }

    // ── Animation loop ────────────────────────────────────────────────────
    function tick() {
      if (!isActive) {
        animFrameId = requestAnimationFrame(tick);
        return;
      }

      ctx!.clearRect(0, 0, canvas.width, canvas.height);

      for (const p of petals) {
        p.time += 1;

        // Organic horizontal swing (simulated wind)
        p.x += p.speedX + Math.sin(p.time * p.swingFreq + p.swingOffset) * 0.55;
        p.y += p.speedY;
        p.rotation += p.rotSpeed;

        // Slight amplitude modulation for natural feel
        p.x += Math.cos(p.time * p.swingFreq * 0.7) * (p.swingAmp * 0.006);

        drawPetal(p);

        // Recycle petal once it exits the canvas (bottom or sides)
        const margin = 40;
        if (
          p.y > canvas.height + margin ||
          p.x < -margin ||
          p.x > canvas.width + margin
        ) {
          // Respawn from the top
          Object.assign(p, createPetal(canvas.width, canvas.height, true));
          p.y = -margin;
          p.x = Math.random() * canvas.width;
        }
      }

      animFrameId = requestAnimationFrame(tick);
    }

    // ── Visibility API — pause when tab is hidden ─────────────────────────
    document.addEventListener('visibilitychange', () => {
      isActive = document.visibilityState === 'visible';
    });

    // ── Responsive resize ─────────────────────────────────────────────────
    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        resize();
      }, 150);
    });

    // ── Start ─────────────────────────────────────────────────────────────
    init();
    tick();
  })();
</script>
