---
// src/components/Hero.astro
// Hero Section — Dark Editorial with Acid Lime accent
---

<section class="hero">
  <!-- Ambient glow -->
  <div class="ambient" aria-hidden="true"></div>

  <!-- Eyebrow -->
  <p class="eyebrow">FULLSTACK DEVELOPER &amp; SOFTWARE ENGINEER — SAN SALVADOR</p>

  <!-- Main Heading h1 -->
  <h1>
    <span class="line-one">Architecture and code</span>
    <span class="line-two">that build <em>products</em> <span class="spark">✦</span></span>
  </h1>

  <!-- Description -->
  <p class="hero-desc">
    I build scalable web platforms, Local-First mobile ecosystems, and real-time solutions with decoupled architectures.
  </p>

  <!-- Circle link pointing to #projects -->
  <a href="#projects" class="circle-link" aria-label="View projects">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </a>
</section>
